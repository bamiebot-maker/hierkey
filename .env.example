# NEAR Protocol Testnet Configuration
VITE_NEAR_NETWORK_ID=testnet
VITE_NEAR_NODE_URL=https://rpc.testnet.near.org
VITE_NEAR_CONTRACT_ID=hierkey.testnet
VITE_CONTRACT_ADDRESS=hierkey.testnet

# Relayer Keeper Configuration (Function-Call Access Key)
KEEPER_ACCOUNT_ID=keeper.hierkey.testnet
KEEPER_PRIVATE_KEY=ed25519:...

# IPFS Pinata Configuration (Encrypted Key Envelopes & Shards)
VITE_PINATA_API_KEY=
VITE_PINATA_API_SECRET=
VITE_PINATA_JWT=
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
